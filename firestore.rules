rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64;
    }

    // User profile document: strict owner-only access
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidId(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254;
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid;
      allow delete: if false;

      // Saved addresses subcollection
      match /addresses/{addressId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(addressId)
          && request.resource.data.street is string
          && request.resource.data.street.size() > 0
          && request.resource.data.street.size() <= 200
          && request.resource.data.city is string
          && request.resource.data.city.size() > 0
          && request.resource.data.city.size() <= 80
          && request.resource.data.pincode is string
          && request.resource.data.pincode.size() >= 4
          && request.resource.data.pincode.size() <= 10;
      }

      // Orders subcollection: immutable userId & createdAt
      match /orders/{orderId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(orderId)
          && request.resource.data.userId == userId
          && request.resource.data.total is number
          && request.resource.data.total >= 0;
        allow update: if isOwner(userId)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
