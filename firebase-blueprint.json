{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated customer profile and preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "alternatePhone": { "type": "string" },
        "dob": { "type": "string" },
        "gender": { "type": "string" },
        "photoURL": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Address": {
      "title": "Address",
      "description": "Customer saved delivery or residential address.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "street": { "type": "string" },
        "landmark": { "type": "string" },
        "city": { "type": "string" },
        "pincode": { "type": "string" },
        "isDefault": { "type": "boolean" }
      },
      "required": ["id", "name", "phone", "street", "city", "pincode"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer marketplace order.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "subtotal": { "type": "number" },
        "bogoSavings": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "total", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document owned by userId."
    },
    "/users/{userId}/addresses/{addressId}": {
      "schema": { "$ref": "#/entities/Address" },
      "description": "User saved addresses subcollection."
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "User orders subcollection."
    }
  }
}
